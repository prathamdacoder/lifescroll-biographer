# ---- AI (required for real biographies) -------------------------------------
GROQ_API_KEY=your_groq_key_here
# Default model. Fallbacks are tried automatically if this one is unavailable.
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODELS=qwen/qwen3.6-27b,openai/gpt-oss-120b,llama-3.3-70b-versatile,llama-3.1-8b-instant
# Qwen3.6/gpt-oss are reasoning models: none | low | medium | high
GROQ_REASONING_EFFORT=none

# ---- Supabase (optional: enables hosted auth + Google OAuth + Postgres) -----
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---- Images -----------------------------------------------------------------
# pollinations (free, no key) | openai (DALL-E 3, needs OPENAI_API_KEY)
IMAGE_PROVIDER=pollinations
# OPENAI_API_KEY=

# ---- App --------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
TARGET_CHAPTERS=12
WORDS_PER_CHAPTER=2100
IMAGES_PER_CHAPTER=6
